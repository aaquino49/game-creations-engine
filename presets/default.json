{
  "_about": "Positions are roles (quarterback, qa_lead, coder_1...); the model under each is one swappable field, so a withdrawn or exhausted model is a one-line change. The fallback chains below are the priority order per position: when a subscription runs out, work moves down the chain until its reset time (paid coder_1 last). coder_1 is pay-per-use; the rest are subscriptions or free tiers. Re-check model ids with `opencode models` and `codex` before a new game.",
  "roles": {"quarterback": "quarterback", "qa": "qa_lead"},
  "accounts": {
    "anthropic": "Anthropic subscription",
    "openai": "OpenAI subscription",
    "meta_api": "Meta API (pay-per-use)"
  },
  "agents": {
    "quarterback": {"kind": "claude", "model": "claude-opus-5-5", "account": "anthropic"},
    "qa_lead": {"kind": "codex", "model": "gpt-6.1-sol", "account": "openai"},
    "coder_1": {"kind": "opencode", "model": "meta/muse-spark-1.3-contributor", "account": "meta_api"},
    "coder_2": {"kind": "codex", "model": "gpt-6-luna", "account": "openai"},
    "coder_3": {"kind": "opencode", "model": "opencode/beam-free"},
    "coder_4": {"kind": "opencode", "model": "opencode/longcat-2.5-preview-free"},
    "coder_5": {"kind": "opencode", "model": "opencode/deepseek-v4.1-flash-free"}
  },
  "coders": ["coder_1"],
  "paid": ["coder_1"],
  "lanes": 3,
  "fallback": {
    "coder_1:*": ["coder_2", "coder_3", "coder_4", "coder_5"],
    "coder_2:*": ["coder_3", "coder_4", "coder_5", "coder_1"],
    "coder_3:*": ["coder_4", "coder_5", "coder_1"],
    "coder_4:*": ["coder_3", "coder_5", "coder_1"],
    "coder_5:*": ["coder_3", "coder_4", "coder_1"],
    "qa_lead:qa": ["coder_3", "coder_4", "coder_5", "coder_1"],
    "qa_lead:work-qa": ["coder_3", "coder_4", "coder_5", "coder_1"],
    "qa_lead:work-asset": [],
    "quarterback:*": ["qa_lead", "coder_1"]
  }
}
